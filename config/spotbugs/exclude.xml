<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">

    <!-- Generator-/Build-Patterns -->
    <Match>
        <Class name="~.*\$AutoValue_.*"/>
    </Match>
    <Match>
        <Source name="~.*/build/generated/.*"/>
    </Match>

    <!-- Combat-State wird per Referenz durchgereicht: Stack ist mutable, BattleSetup hält die
         Stacks, Action-Records tragen Stack-Targets, defensive Kopien wären sinnlos. -->
    <Match>
        <Class name="~.*\.application\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~.*\.domain\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- DTO-/Value-Records am REST-Boundary: Listen/Sets durchgereicht ohne Defensiv-Kopie,
         Jackson serialisiert sie ohnehin direkt zu JSON. -->
    <Match>
        <Class name="~.*\.values\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Konstruktor-Validation per IllegalArgumentException ist gewollt; CT_CONSTRUCTOR_THROW
         meldet das pauschal. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
